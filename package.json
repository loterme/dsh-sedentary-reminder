{
  "name": "dsh-sedentary-reminder",
  "version": "1.0.0",
  "description": "A slim sitting timer under the composer and a card that slides up from the bottom inviting you to stand up and move.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "reminder",
    "health",
    "break",
    "sedentary"
  ],
  "license": "MIT",
  "author": "loterme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loterme/dsh-sedentary-reminder.git"
  },
  "homepage": "https://github.com/loterme/dsh-sedentary-reminder#readme",
  "bugs": {
    "url": "https://github.com/loterme/dsh-sedentary-reminder/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
